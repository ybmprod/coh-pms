# ---------------------------------------------------------------------------
# COH-PMS environment settings
# Copy this file to .env and adjust for your machine. Never commit the real .env.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_TIMEZONE=Africa/Harare
SESSION_TIMEOUT=3600

# Full public URL of the app. Leave blank to auto-detect from the request.
# Examples:
#   http://coh-pms.test
#   http://localhost/coh-pms/public
APP_URL=

# Optional deployment alias used by some council integration environments.
# APP_URL takes precedence when both are set.
APP_BASE_URL=

# Email delivery for account invitations and password-change links.
# auto - development: local outbox; production: PHP mail() when SMTP is set
# mail - use PHP mail() (development also keeps an outbox copy)
# log  - write to storage/logs/mail.log without sending
MAIL_TRANSPORT=auto
MAIL_FROM=no-reply@hararecity.co.zw

# Rows per page on staff lists and report tables (clamped to 5-100).
PAGINATION_PER_PAGE=15

# Database (Laragon defaults shown)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=coh_pms
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Optional least-privilege account used only for customer read models.
# Leave blank to keep using DB_USER. See
# database/security/least_privilege_accounts.sql.example for the grants.
DB_USER_CUSTOMER=
DB_PASS_CUSTOMER=
